 Function LayerFromString(LName: String): TLayer;
+Var
+    MechN : Integer;
 Begin
+    If CheckLeft(LName, 'Mechanical') Then Begin
+        MechN := 0;
+        Try
+            MechN := StrToInt(RightOf(LName, 'Mechanical'));
+        Except
+            MechN := 0;
+        End;
+        If (MechN >= 17) And (MechN <= 32) Then Begin
+            Result := eNoLayer;
+            Try
+                Result := LayerUtils.MechanicalLayer(MechN);
+            Except
+                Result := eNoLayer;
+            End;
+            Exit;
+        End;
+    End;
     Case LName Of
     'NoLayer':         Result := eNoLayer;
     'TopLayer':        Result := eTopLayer;
